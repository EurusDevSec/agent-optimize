{
  "mcpServers": {
    "fetch": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp<1.2.0",
        "mcp-server-fetch"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "git": {
      "command": "npx",
      "args": [
        "-y",
        "@cyanhead/git-mcp-server"
      ]
    }
  }
}